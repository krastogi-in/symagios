{
  "_comment": "Shape-only example. Real values live in .env / Vault — never commit secrets.",
  "symagios/keycloak/admin": {
    "username": "admin",
    "password": "<from-.env KEYCLOAK_ADMIN_PASSWORD>"
  },
  "symagios/keycloak/clients/symagios-gateway": {
    "client_id": "symagios-gateway",
    "client_secret": "<from-.env SYMAGIOS_GATEWAY_CLIENT_SECRET>"
  },
  "symagios/keycloak/clients/symagios-cli": {
    "client_id": "symagios-cli",
    "public": true
  },
  "symagios/keycloak/users/admin": {
    "username": "symagios-admin",
    "password": "<from-.env SYMAGIOS_ADMIN_PASSWORD>",
    "roles": "admin"
  },
  "symagios/keycloak/users/operator": {
    "username": "operator",
    "password": "<from-.env SYMAGIOS_OPERATOR_PASSWORD>",
    "roles": "operator,agent-runner"
  },
  "symagios/keycloak/users/runner": {
    "username": "runner",
    "password": "<from-.env SYMAGIOS_RUNNER_PASSWORD>",
    "roles": "agent-runner"
  },
  "symagios/engine": {
    "encryption_key": "<from-.env SYMAGIOS_ENGINE_ENCRYPTION_KEY>"
  },
  "symagios/tavily": {
    "api_key": "<set TAVILY_API_KEY when seeding>"
  }
}
